[
  {"id": "RSA-1", "pattern": "rsa\\.generate_private_key|RSA\\.generate|RSA\\.construct", "algorithm": "RSA", "category": "asymmetric", "status": "vulnerable", "replacement": "ML-KEM (encryption) / ML-DSA (signatures), hybrid with classical during transition"},
